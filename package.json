{
  "name": "oauth-mtls-reference",
  "version": "1.0.0",
  "private": true,
  "description": "Runnable reference for OAuth 2.0 with PAR, PKCE, private_key_jwt and mTLS certificate-bound access tokens (RFC 8705)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "certs": "./scripts/gen-certs.sh",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "demo": "node dist/demo-client/src/main.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/oidc-provider": "^9.12.1",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  }
}
