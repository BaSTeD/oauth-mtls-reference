# Copy to .env before starting the stack. These are local demo values only.

# Signs the authorization server's session cookies.
# Generate one with: openssl rand -hex 32
COOKIE_SECRET=change-me

# The single demo account the client signs in with.
DEMO_USERNAME=alice
DEMO_PASSWORD=change-me

# Host ports (bound to 127.0.0.1). Change them if they are taken.
AUTH_SERVER_PORT=8443
RESOURCE_SERVER_PORT=9443
